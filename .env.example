# Copy this file to .env in the project root (same folder as this file)
# and fill in your key. app/config.py loads it automatically via
# python-dotenv — no need to export anything manually. Never commit .env.

# Required for AI Chat. Everything else (table preview, SQL Workspace,
# import/export, history) works without it.
GROQ_API_KEY=

# Optional — the values below are the defaults.
# GROQ_MODEL=openai/gpt-oss-120b
# MAX_UPLOAD_MB=50
# MAX_SQL_RESULT_ROWS=5000
# MAX_EXPORT_ROWS=50000
# SQL_TIMEOUT_MS=5000
# LOG_LEVEL=INFO

# Backups kept per database (oldest are removed beyond this; 0 keeps all).
# MAX_BACKUPS_PER_DB=25

# Accounts. The first account can always be created. Set ALLOW_SIGNUP=false
# once everyone has one, to stop anyone else registering.
# ALLOW_SIGNUP=true
# SESSION_DAYS=14

# Comma-separated origins allowed to call the API from another site.
# Leave unset for same-origin only, which is all the bundled UI needs.
# ALLOWED_ORIGINS=http://localhost:5173

# Where uploads/, backups/ and data/ are kept. Defaults to the project folder.
# ENG2SQL_HOME=
